# Connexion PostgreSQL — copier ce fichier en .env et adapter les valeurs
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base_de_donnees

# Clé secrète Flask pour sécuriser les sessions
SECRET_KEY=votre_cle_secrete_aleatoire

# Identifiants de connexion
AUTH_USERNAME=joueur
AUTH_PASSWORD=votre_mot_de_passe

